{
  "name": "win-today",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/domain.test.js tests/history.test.js tests/profile.test.js tests/task-text.test.js tests/users.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-win-today 'node --test tests/rules.test.js'",
    "test:access": "firebase emulators:exec --only auth,firestore --project demo-win-today --config firebase.access-test.json 'node tests/access-browser.mjs'",
    "test:browser": "node tests/browser-smoke.mjs",
    "format": "prettier --write src tests vite.config.js index.html firebase.json firestore.indexes.json package.json",
    "test:editor": "node tests/task-editor.mjs",
    "test:creation": "node tests/habit-creation.mjs",
    "test:week-scroll": "node tests/week-scroll.mjs",
    "test:manage": "node tests/my-habits.mjs",
    "test:cards": "node tests/compact-cards.mjs",
    "test:past": "node tests/past-completion.mjs",
    "test:daily": "node tests/daily-loop.mjs",
    "test:mobile": "node tests/mobile-layout.mjs",
    "test:order": "node tests/habit-order.mjs",
    "test:privacy": "firebase emulators:exec --only auth,firestore --project demo-win-today --config firebase.access-test.json 'node tests/privacy-browser.mjs'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.6.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^0.21.0"
  }
}
